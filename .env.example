# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://driverx_user:driverx_password@localhost:5432/driverx_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="replace-with-a-secure-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-jwt-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
